<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext traffic is allowed only for the CDN host used to serve forum
     media (images/attachments). The main API host is always HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">mt2.cn</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">binmt.cc</domain>
    </domain-config>
</network-security-config>